# Copy to .env and fill in, or export these in your process manager / systemd unit.
# The value MUST match the "Shared HMAC Secret" set in
# WordPress -> Settings -> Sports Player Platform -> Real-Time Messaging.

SPP_WS_SECRET=replace-with-the-same-secret-as-wordpress
SPP_WS_PORT=8080
SPP_WS_HOST=0.0.0.0
